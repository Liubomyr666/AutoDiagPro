<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AutoDiagPro.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>AutoDiag Pro</ApplicationTitle>
    <ApplicationId>com.autodiagpro.app</ApplicationId>
    <ApplicationDisplayVersion>2.1.3</ApplicationDisplayVersion>
    <ApplicationVersion>12</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="Plugin.BLE" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0B0F12" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#090C0E" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>
</Project>
